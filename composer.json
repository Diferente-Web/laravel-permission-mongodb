{
    "name": "diferente-web/laravel-permission-mongodb",
    "description": "Permission handling for Laravel 11, 12 and 13 using MongoDB. Maintained fork of mostafamaklad/laravel-permission-mongodb",
    "keywords": [
        "laravel",
        "security",
        "mongodb",
        "permission",
        "acl",
        "mostafamaklad",
        "maklad",
        "mostafa",
        "spatie"
    ],
    "homepage": "https://github.com/Diferente-Web/laravel-permission-mongodb",
    "license": "MIT",
    "authors": [
        {
            "name": "Mostafa Maklad",
            "email": "dev.mostafa.maklad@gmail.com",
            "homepage": "https://github.com/mostafamaklad",
            "role": "Developer"
        },
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "homepage": "https://spatie.be",
            "role": "The original module"
        },
        {
            "name": "Diferente Web",
            "homepage": "https://github.com/Diferente-Web",
            "role": "Maintainer of this fork"
        }
    ],
    "support": {
        "source": "https://github.com/Diferente-Web/laravel-permission-mongodb"
    },
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "mongodb/laravel-mongodb": "^5.7"
    },
    "conflict": {
        "mostafamaklad/laravel-permission-mongodb": "*"
    },
    "require-dev": {
        "monolog/monolog": "^3.2",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Maklad\\Permission\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maklad\\Permission\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs --standard=psr2 src/",
        "fix-style": "phpcbf --standard=psr2 src/"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maklad\\Permission\\PermissionServiceProvider"
            ]
        }
    }
}
